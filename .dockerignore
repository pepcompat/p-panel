# pPanel image build context = repo root (apps/api/Dockerfile, apps/web/Dockerfile).
# Never send secrets, local state or build output to the daemon.
**/node_modules
**/dist
**/.next
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/.turbo
**/__pycache__
**/.DS_Store
**/*.log
# secrets / local env (all of them, including examples: nothing env-shaped is baked into an image)
**/.env
**/.env.*
**/*.pem
**/*.key
.lab
.git
.github
.husky
.vscode
.idea
# not needed by the API / web images
apps/agent
infra
scripts
docs
design
tests
dist-release
apps/web/tests
apps/api/test
