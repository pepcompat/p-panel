# pPanel Center — copy to .env (never commit .env)
DATABASE_URL=postgresql://ppanel:ppanel_dev_only@127.0.0.1:55432/ppanel?schema=public
REDIS_URL=redis://127.0.0.1:56379
API_PORT=4000
AGENT_GATEWAY_PORT=4443
PPANEL_GATEWAY_HOSTNAMES=localhost,host.docker.internal
PPANEL_PUBLIC_GATEWAY_URL=https://localhost:4443
# 32 random bytes, base64: openssl rand -base64 32
PPANEL_MASTER_KEY=
JWT_ACCESS_SECRET=
PPANEL_SETUP_TOKEN=
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
# Git hosts allowed for builds (comma list host[:port]); `lab-git` is added automatically outside production
PPANEL_GIT_HOST_ALLOWLIST=github.com
# Container registries pPanel may resolve/pull/push (comma list host[:port]); see API_CONTRACTS §7.5
PPANEL_REGISTRY_ALLOWLIST=
# --- P5 observability (infra/observability, scripts/observability/up.sh) ---
PPANEL_PROMETHEUS_URL=http://127.0.0.1:59090
PPANEL_LOKI_URL=http://127.0.0.1:53100
# bearer for GET /internal/metrics; up.sh writes .lab/observability/scrape-token (or set PPANEL_METRICS_SCRAPE_TOKEN, ≥ 32 chars)
# PPANEL_METRICS_SCRAPE_TOKEN_FILE=/abs/path/to/repo/.lab/observability/scrape-token   (unset = endpoint 404)
PPANEL_OBS_TIMEOUT_MS=5000
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=2GB
LOKI_RETENTION_PERIOD=168h
LOKI_INGESTION_RATE_MB=8
LOKI_INGESTION_BURST_MB=16
# per-server log ingest budget (decompressed bytes) → 429 Retry-After
PPANEL_LOG_INGEST_RATE_BYTES=2097152
PPANEL_LOG_INGEST_BURST_BYTES=10485760
PPANEL_LOG_TAIL_POLL_MS=2000
PPANEL_LOG_TAIL_MAX_SEC=900
PPANEL_ALERT_EVAL_INTERVAL_MS=15000
PPANEL_PUBLIC_WEB_URL=http://localhost:3100
# webhook channels: hosts allowed over http (never in production) / exempt from the private-address block
PPANEL_WEBHOOK_HTTP_ALLOWLIST=
PPANEL_WEBHOOK_ALLOWLIST=
# email channel (lab: Mailpit)
PPANEL_SMTP_URL=smtp://127.0.0.1:51025
PPANEL_SMTP_FROM=pPanel <alerts@ppanel.local>
PPANEL_TELEGRAM_API_BASE=https://api.telegram.org
PPANEL_NOTIFY_TIMEOUT_MS=5000
PPANEL_NOTIFY_RETRY_BASE_MS=1000
# --- P6 backups (API_CONTRACTS §10, docs/RECOVERY_RUNBOOK.md) ---
# bearer for POST /api/v1/backup-maintenance/reports (operator maintenance script; ≥ 32 chars; unset = endpoint 404)
PPANEL_BACKUP_REPORT_TOKEN=
PPANEL_BACKUP_SCHEDULER_INTERVAL_MS=30000
# TTL of backup.run / restore.run jobs (an agent that never finishes → run `expired`)
PPANEL_BACKUP_JOB_TTL_SEC=21600
# Center self-backup (scripts/backup/center-backup.sh / center-restore.sh) — NOT read by the API.
# Separate restic repo for the Center; password escrowed offline (never stored in the repo).
# PPANEL_CENTER_BACKUP_REPO=rest:https://center:<pw>@backup.internal:8000/center/
# PPANEL_CENTER_BACKUP_PASSWORD=
# PPANEL_CENTER_ENV_FILE=/etc/ppanel/center.env   (copied with every secret value removed)
# PPANEL_BACKUP_TOOLS=auto   (auto | host | docker: postgres:16.6-alpine + restic/restic:0.17.3)
