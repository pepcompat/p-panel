# pPanel Center — copy to .env (never commit .env)
DATABASE_URL=postgresql://ppanel:ppanel_dev_only@127.0.0.1:55432/ppanel?schema=public
REDIS_URL=redis://127.0.0.1:56379
API_PORT=4000
AGENT_GATEWAY_PORT=4443
PPANEL_GATEWAY_HOSTNAMES=localhost,host.docker.internal
PPANEL_PUBLIC_GATEWAY_URL=https://localhost:4443
# 32 random bytes, base64: openssl rand -base64 32
PPANEL_MASTER_KEY=
JWT_ACCESS_SECRET=
PPANEL_SETUP_TOKEN=
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
# Git hosts allowed for builds (comma list host[:port]); `lab-git` is added automatically outside production
PPANEL_GIT_HOST_ALLOWLIST=github.com
# Container registries pPanel may resolve/pull/push (comma list host[:port]); see API_CONTRACTS §7.5
PPANEL_REGISTRY_ALLOWLIST=
