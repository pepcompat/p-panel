// pPanel Center — PostgreSQL schema. snake_case tables/columns (COMPATTANA standard).
// IDs are UUID v7 generated by the application (src/common/ids.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  status       String    @default("active") // active | disabled
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]
  roleBindings  RoleBinding[]

  @@map("users")
}

/// One row per refresh token. Rotation creates a new row in the same family.
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256 hex
  amr              String[]  @default([])
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model MfaFactor {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String    @default("totp")
  secretEnc    String    @map("secret_enc") // AES-256-GCM (PPANEL_MASTER_KEY)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep Int?      @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") // sha256 hex
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model RoleBinding {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleKey     String   @map("role_key")
  scopeType   String   @map("scope_type") // global | environment | project | server
  scopeId     String?  @map("scope_id")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("role_bindings")
}

model ServerGroup {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  environment String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  servers Server[]

  @@map("server_groups")
}

model Server {
  id               String    @id @db.Uuid
  name             String
  hostname         String
  environment      String
  groupId          String?   @map("group_id") @db.Uuid
  tags             String[]  @default([])
  /// Stored lifecycle status. stale/offline are derived on read from last_heartbeat_at.
  status           String    @default("enrolling")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  lastSeq          BigInt?   @map("last_seq")
  agentVersion     String?   @map("agent_version")
  os               Json?
  provider         Json?
  connectionPolicy String    @default("auto") @map("connection_policy")
  metrics          Json?
  metricsSampledAt DateTime? @map("metrics_sampled_at") @db.Timestamptz(3)
  /// systemd units this server's owner allowlisted for typed jobs (service.restart).
  ownedUnits       String[]  @default([]) @map("owned_units")
  /// P4b: Center-side build node designation (agent must also report the `build` capability)
  buildNode        Boolean   @default(false) @map("build_node")
  /// P10: agent facts `ssh` ({ hostKeys: [{ algorithm, fingerprintSha256 }], port }), null = absent
  sshFacts         Json?     @map("ssh_facts")
  enrollmentId     String?   @map("enrollment_id") @db.Uuid
  version          Int       @default(1)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group            ServerGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses        ServerAddress[]
  certificates     AgentCertificate[]
  heartbeats       AgentHeartbeat[]
  capabilities     ServerCapability[]
  jobs             Job[]
  scans            DiscoveryScan[]
  applications     Application[]
  managedRouting   ManagedRouting?
  portAllocations  HostPortAllocation[]
  containerSamples ContainerSample[]
  telemetry        ServerTelemetry?
  incidents        Incident[]
  backupAccess     BackupRepoAccess[]
  backupPolicies   BackupPolicy[]
  connection       ServerConnection?
  networkInventory ServerNetworkInventory[]
  connectivityFrom NetworkConnectivityTest[] @relation("connectivityFrom")
  connectivityTo   NetworkConnectivityTest[] @relation("connectivityTo")
  gateway          Gateway?
  sshEndpoints     SshEndpoint[]
  sshDeployments   SshKeyDeployment[]
  sshHostKeys      SshHostKey[]
  sshGrants        SshAccessGrant[]
  sshSessions      SshSession[]

  @@index([environment])
  @@index([lastHeartbeatAt])
  @@map("servers")
}

model ServerAddress {
  id         String    @id @db.Uuid
  serverId   String    @map("server_id") @db.Uuid
  family     String // ipv4 | ipv6
  scope      String // public | private
  address    String
  interface  String?
  source     String    @default("detected") // detected | override
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, address, source])
  @@map("server_addresses")
}

model AgentEnrollment {
  id          String    @id @db.Uuid
  name        String
  environment String
  tags        String[]  @default([])
  tokenHash   String    @unique @map("token_hash") // sha256 hex, token itself never stored
  ttlMinutes  Int       @map("ttl_minutes")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  serverId    String?   @map("server_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("agent_enrollments")
}

model AgentCertificate {
  id                String    @id @db.Uuid
  serverId          String    @map("server_id") @db.Uuid
  serial            String    @unique // lowercase hex, no leading zeros
  fingerprintSha256 String    @map("fingerprint_sha256")
  certPem           String    @map("cert_pem")
  notBefore         DateTime  @map("not_before") @db.Timestamptz(3)
  notAfter          DateTime  @map("not_after") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("agent_certificates")
}

/// Bounded: retention sweeper keeps the last PPANEL_HEARTBEAT_KEEP rows per server.
model AgentHeartbeat {
  id           BigInt    @id @default(autoincrement())
  serverId     String    @map("server_id") @db.Uuid
  seq          BigInt
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  agentVersion String?   @map("agent_version")
  metrics      Json?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, receivedAt(sort: Desc)])
  @@map("agent_heartbeats")
}

model ServerCapability {
  serverId   String   @map("server_id") @db.Uuid
  name       String
  details    Json?
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, name])
  @@map("server_capabilities")
}

model CaKey {
  id            String   @id @db.Uuid
  purpose       String // agent_ca
  algorithm     String   @default("ECDSA-P256")
  certPem       String   @map("cert_pem")
  privateKeyEnc String   @map("private_key_enc") // AES-256-GCM (PPANEL_MASTER_KEY), PKCS#8
  active        Boolean  @default(true)
  notAfter      DateTime @map("not_after") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, active])
  @@map("ca_keys")
}

model Job {
  id               String    @id @db.Uuid
  serverId         String    @map("server_id") @db.Uuid
  type             String
  params           Json      @default("{}")
  status           String    @default("queued")
  mutating         Boolean
  /// per-server resource lock key for mutating jobs (e.g. "unit:nginx.service")
  resourceKey      String?   @map("resource_key")
  idempotencyKey   String    @map("idempotency_key")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseTokenHash   String?   @map("lease_token_hash")
  leasedAt         DateTime? @map("leased_at") @db.Timestamptz(3)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(3)
  attempt          Int       @default(0)
  desiredVersion   Int?      @map("desired_version")
  actorId          String?   @map("actor_id") @db.Uuid
  correlationId    String    @map("correlation_id")
  result           Json?
  error            Json?
  /// P4: set when the agent fetched this job's secrets (fetch-once, container.run_candidate only)
  secretsFetchedAt DateTime? @map("secrets_fetched_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, idempotencyKey])
  @@index([serverId, status, createdAt])
  @@index([status, leaseUntil])
  @@map("jobs")
}

model AuditEvent {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id")
  actorType  String   @default("user") @map("actor_type") // user | agent | system | anonymous
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  result     String // success | failure | denied
  requestId  String?  @map("request_id")
  diffHash   String?  @map("diff_hash")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// P3 — discovery, applications (ownership tiers), Nginx config revisions
// ---------------------------------------------------------------------------

/// One discovery.scan job → one scan snapshot (ingested idempotently per job_id).
model DiscoveryScan {
  id          String    @id @db.Uuid
  serverId    String    @map("server_id") @db.Uuid
  jobId       String    @unique @map("job_id") @db.Uuid
  status      String    @default("running") // running | completed | failed | expired
  sources     String[]  @default([])
  requestedBy String?   @map("requested_by") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  summary     Json?
  configFiles Json      @default("[]") @map("config_files")
  drift       Json      @default("[]")
  error       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server   Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  findings DiscoveryFinding[]

  @@index([serverId, completedAt(sort: Desc)])
  @@index([status])
  @@map("discovery_scans")
}

model DiscoveryFinding {
  id                    String   @id @db.Uuid
  scanId                String   @map("scan_id") @db.Uuid
  serverId              String   @map("server_id") @db.Uuid
  kind                  String // nginx_server | php_fpm_pool | listener | container | systemd_unit | upstream
  fingerprint           String
  externalId            String?  @map("external_id")
  title                 String
  domains               String[] @default([])
  listen                String[] @default([])
  provenance            Json?
  confidence            String // high | medium | low
  manualReviewRequired  Boolean  @default(false) @map("manual_review_required")
  reasons               String[] @default([])
  unsupportedDirectives String[] @default([]) @map("unsupported_directives")
  conflicts             Json     @default("[]")
  links                 Json     @default("{}")
  applicationId         String?  @map("application_id") @db.Uuid
  data                  Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scan        DiscoveryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  application Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([scanId, fingerprint])
  @@index([scanId, kind])
  @@index([serverId, fingerprint])
  @@map("discovery_findings")
}

model Application {
  id                       String   @id @db.Uuid
  serverId                 String   @map("server_id") @db.Uuid
  name                     String
  kind                     String // nginx_static | nginx_php | nginx_proxy | unknown | container
  domains                  String[] @default([])
  ownershipMode            String   @default("observed") @map("ownership_mode")
  flagUnsupported          Boolean  @default(false) @map("flag_unsupported")
  flagConflict             Boolean  @default(false) @map("flag_conflict")
  flagManualReview         Boolean  @default(false) @map("flag_manual_review")
  flagDriftDetected        Boolean  @default(false) @map("flag_drift_detected")
  reasons                  String[] @default([])
  unsupportedDirectives    String[] @default([]) @map("unsupported_directives")
  sourceFindingFingerprint String   @map("source_finding_fingerprint")
  /// [{ path, lastKnownSha256 }]
  nginxFiles               Json     @default("[]") @map("nginx_files")
  /// [{ path, lastKnownSha256, currentSha256 }] — non-empty iff flag_drift_detected
  driftFiles               Json     @default("[]") @map("drift_files")
  lastScanId               String?  @map("last_scan_id") @db.Uuid
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server               Server                @relation(fields: [serverId], references: [id], onDelete: Cascade)
  findings             DiscoveryFinding[]
  reviews              AdoptionReview[]
  revisions            NginxConfigRevision[]
  container            ContainerApp?
  secrets              Secret[]
  deployments          Deployment[]
  autoDeployPolicies   AutoDeployPolicy[]
  pendingWebhookDeploy PendingWebhookDeploy?
  buildConfig          BuildConfig?
  builds               Build[]
  composeVersions      ComposeAppVersion[]
  sourceInspections    SourceInspection[]

  @@unique([serverId, sourceFindingFingerprint])
  @@unique([serverId, name])
  @@index([ownershipMode])
  @@map("applications")
}

/// Ownership tier change history (append-only).
model AdoptionReview {
  id                  String   @id @db.Uuid
  applicationId       String   @map("application_id") @db.Uuid
  fromMode            String   @map("from_mode")
  toMode              String   @map("to_mode")
  actorId             String   @map("actor_id") @db.Uuid
  reason              String
  acknowledgedReasons String[] @default([]) @map("acknowledged_reasons")
  stepUp              Boolean  @default(false) @map("step_up")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("adoption_reviews")
}

model NginxConfigRevision {
  id               String   @id @db.Uuid
  serverId         String   @map("server_id") @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  status           String   @default("draft")
  /// [{ path, beforeSha256, afterSha256, diff, content }]
  files            Json
  planHash         String   @map("plan_hash")
  postchecks       Json     @default("[]")
  approvalRequired Boolean  @map("approval_required")
  validateJobId    String?  @map("validate_job_id") @db.Uuid
  validation       Json?
  applyJobId       String?  @map("apply_job_id") @db.Uuid
  revertJobId      String?  @map("revert_job_id") @db.Uuid
  result           Json?
  createdBy        String   @map("created_by") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvals   NginxRevisionApproval[]

  @@index([applicationId, createdAt])
  @@index([serverId, status])
  @@map("nginx_config_revisions")
}

/// Single-use, planHash-bound approval with expiry.
model NginxRevisionApproval {
  id            String    @id @db.Uuid
  revisionId    String    @map("revision_id") @db.Uuid
  approverId    String    @map("approver_id") @db.Uuid
  planHash      String    @map("plan_hash")
  approvedAt    DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  usedByJobId   String?   @map("used_by_job_id") @db.Uuid
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  revision NginxConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, approvedAt])
  @@map("nginx_revision_approvals")
}

// ---------------------------------------------------------------------------
// P4a — container applications, secrets, deployments, managed routing, webhooks
// ---------------------------------------------------------------------------

/// 1:1 extension of `applications` for kind = container (ownership managed, source of truth = pPanel).
model ContainerApp {
  applicationId        String   @id @map("application_id") @db.Uuid
  containerPort        Int      @map("container_port")
  healthcheck          Json
  resources            Json
  /// plain, non-secret env { KEY: value }
  env                  Json     @default("{}")
  /// declared secret keys (values live in `secrets`)
  secretKeys           String[] @default([]) @map("secret_keys")
  volumes              Json     @default("[]")
  tls                  Json?
  currentDeploymentId  String?  @map("current_deployment_id") @db.Uuid
  previousDeploymentId String?  @map("previous_deployment_id") @db.Uuid
  /// sha256 of the route.conf content pPanel last applied (drift guard for the next switch)
  routeSha256          String?  @map("route_sha256")
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("container_apps")
}

/// AES-256-GCM (PPANEL_MASTER_KEY, AAD = applicationId + ":" + key). Values are never returned.
model Secret {
  id             String   @id @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  key            String
  valueEncrypted String   @map("value_encrypted")
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@map("secrets")
}

model Deployment {
  id                     String    @id @db.Uuid
  applicationId          String    @map("application_id") @db.Uuid
  serverId               String    @map("server_id") @db.Uuid
  number                 Int
  trigger                String // manual | webhook | rollback | redeploy
  image                  String
  sourceRef              Json?     @map("source_ref")
  reason                 String?
  status                 String
  preflight              Json      @default("[]")
  containerName          String?   @map("container_name")
  hostPort               Int?      @map("host_port")
  /// set when the agent confirmed container.remove (or the candidate was removed by the agent)
  containerRemovedAt     DateTime? @map("container_removed_at") @db.Timestamptz(3)
  previousDeploymentId   String?   @map("previous_deployment_id") @db.Uuid
  rollbackOfDeploymentId String?   @map("rollback_of_deployment_id") @db.Uuid
  planHash               String    @map("plan_hash")
  approvalRequired       Boolean   @map("approval_required")
  idempotencyKey         String?   @map("idempotency_key")
  /// commit SHA for webhook dedupe (one deployment per commit per app)
  commitSha              String?   @map("commit_sha")
  webhookDeliveryId      String?   @map("webhook_delivery_id") @db.Uuid
  /// P4b: build that produced the image
  buildId                String?   @map("build_id") @db.Uuid
  /// P4b compose: version deployed + normalised plan with digests/specHashes (no secret values)
  composeVersionId       String?   @map("compose_version_id") @db.Uuid
  plan                   Json?
  /// P4b compose: per-service results reported by compose.apply
  serviceResults         Json?     @map("service_results")
  createdBy              String?   @map("created_by") @db.Uuid
  error                  Json?
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt             DateTime? @map("finished_at") @db.Timestamptz(3)

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  steps       DeploymentStep[]

  @@unique([applicationId, number])
  @@unique([applicationId, idempotencyKey])
  @@index([serverId, status])
  @@index([status, updatedAt])
  @@index([applicationId, commitSha])
  @@map("deployments")
}

model DeploymentStep {
  id           String    @id @db.Uuid
  deploymentId String    @map("deployment_id") @db.Uuid
  seq          Int
  name         String
  status       String    @default("pending")
  jobId        String?   @map("job_id") @db.Uuid
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  message      String?
  errorCode    String?   @map("error_code")
  logTail      String[]  @default([]) @map("log_tail")
  /// step-specific data (e.g. target container for prune/cleanup)
  data         Json      @default("{}")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, seq])
  @@index([jobId])
  @@index([status])
  @@map("deployment_steps")
}

/// Single-use, planHash-bound, expiring approval for deployments and managed-routing bootstrap.
model OperationApproval {
  id            String    @id @db.Uuid
  subjectType   String    @map("subject_type") // deployment | managed_routing
  subjectId     String    @map("subject_id") @db.Uuid
  approverId    String    @map("approver_id") @db.Uuid
  planHash      String    @map("plan_hash")
  approvedAt    DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  usedByJobId   String?   @map("used_by_job_id") @db.Uuid
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, approvedAt])
  @@map("operation_approvals")
}

/// Per-server managed routing bootstrap (/etc/nginx/conf.d/ppanel-managed.conf).
model ManagedRouting {
  serverId         String   @id @map("server_id") @db.Uuid
  status           String // awaiting_approval | applying | enabled | failed | requires_manual_recovery
  /// id used as nginx revisionId (agent backup key)
  revisionId       String   @map("revision_id") @db.Uuid
  planHash         String   @map("plan_hash")
  approvalRequired Boolean  @map("approval_required")
  applyJobId       String?  @map("apply_job_id") @db.Uuid
  error            Json?
  createdBy        String   @map("created_by") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("managed_routing")
}

/// Host ports (127.0.0.1, 20000–29999) reserved for managed containers; row exists while allocated.
model HostPortAllocation {
  serverId      String   @map("server_id") @db.Uuid
  port          Int
  applicationId String?  @map("application_id") @db.Uuid
  deploymentId  String?  @map("deployment_id") @db.Uuid
  containerName String?  @map("container_name")
  /// container | external_in_use (agent reported PORT_IN_USE)
  reason        String   @default("container")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, port])
  @@index([deploymentId])
  @@map("host_port_allocations")
}

model Integration {
  id               String   @id @db.Uuid
  kind             String   @default("github")
  name             String
  /// AES-256-GCM (AAD = "integration:" + id)
  webhookSecretEnc String   @map("webhook_secret_enc")
  enabled          Boolean  @default(true)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]
  policies   AutoDeployPolicy[]

  @@map("integrations")
}

/// Only fields needed for audit/dedupe are stored — never the raw payload.
model WebhookDelivery {
  id            String   @id @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  deliveryId    String   @map("delivery_id")
  event         String
  repo          String?
  ref           String?
  after         String?
  signatureOk   Boolean  @map("signature_ok")
  result        String // deployed | awaiting_approval | ignored | failed | building | queued | superseded
  reasons       String[] @default([])
  deploymentIds String[] @default([]) @map("deployment_ids")
  buildIds      String[] @default([]) @map("build_ids")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  integration    Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  pendingDeploys PendingWebhookDeploy[]

  @@unique([integrationId, deliveryId])
  @@index([integrationId, receivedAt])
  @@map("webhook_deliveries")
}

model AutoDeployPolicy {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  repo          String
  branches      String[]
  /// image | build (P4b)
  mode          String   @default("image")
  /// required in image mode; null in build mode
  imageTemplate String?  @map("image_template")
  enabled       Boolean  @default(true)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application    Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  integration    Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  pendingDeploys PendingWebhookDeploy[]

  @@unique([applicationId, integrationId, repo])
  @@index([integrationId, repo])
  @@map("auto_deploy_policies")
}

/// P7 (F-7): the latest webhook commit waiting for the app's running deployment to end ("latest wins":
/// one row per app, replaced by newer pushes; started automatically when no deployment is active).
model PendingWebhookDeploy {
  applicationId String   @id @map("application_id") @db.Uuid
  policyId      String   @map("policy_id") @db.Uuid
  /// webhook_deliveries.id of the delivery that queued this commit
  deliveryRowId String   @map("delivery_row_id") @db.Uuid
  repo          String
  branch        String
  commitSha     String   @map("commit_sha")
  queuedAt      DateTime @default(now()) @map("queued_at") @db.Timestamptz(3)

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policy      AutoDeployPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  delivery    WebhookDelivery  @relation(fields: [deliveryRowId], references: [id], onDelete: Cascade)

  @@index([deliveryRowId])
  @@map("pending_webhook_deploys")
}

/// P4b: per-application build source (container apps).
model BuildConfig {
  applicationId String   @id @map("application_id") @db.Uuid
  repoUrl       String   @map("repo_url")
  subdir        String   @default("")
  dockerfile    String?
  template      String?
  buildArgs     Json     @default("{}") @map("build_args")
  target        String?
  buildServerId String   @map("build_server_id") @db.Uuid
  pushRepo      String   @map("push_repo")
  network       String   @default("default")
  limits        Json     @default("{}")
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String   @map("updated_by") @db.Uuid
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([buildServerId])
  @@map("build_configs")
}

/// P4b: image build from a pinned commit on a build node (image.build job).
model Build {
  id                String    @id @db.Uuid
  applicationId     String    @map("application_id") @db.Uuid
  buildServerId     String    @map("build_server_id") @db.Uuid
  status            String
  commitSha         String    @map("commit_sha")
  branch            String?
  trigger           String
  repo              String?
  dockerfile        String?
  template          String?
  pushRepo          String    @map("push_repo")
  image             String?
  deployAfter       Boolean   @map("deploy_after")
  force             Boolean   @default(false)
  logTail           String[]  @default([]) @map("log_tail")
  /// full bounded log (≤ 2000 lines / 512 KiB), ANSI-free, secret values redacted
  log               String[]  @default([])
  logTruncated      Boolean   @default(false) @map("log_truncated")
  error             Json?
  durationMs        Int?      @map("duration_ms")
  jobId             String?   @map("job_id") @db.Uuid
  deploymentId      String?   @map("deployment_id") @db.Uuid
  deployError       Json?     @map("deploy_error")
  idempotencyKey    String?   @map("idempotency_key")
  webhookDeliveryId String?   @map("webhook_delivery_id") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, commitSha])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("builds")
}

/// P4b: stored compose file versions (validated YAML + normalised plan metadata).
model ComposeAppVersion {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  version       Int
  yaml          String
  yamlSha256    String   @map("yaml_sha256")
  routeService  String   @map("route_service")
  routePort     Int      @map("route_port")
  healthPath    String   @default("/") @map("health_path")
  /// normalised services in dependency order (images as written; no secret values)
  plan          Json
  secretKeys    String[] @default([]) @map("secret_keys")
  warnings      Json     @default("[]")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@map("compose_app_versions")
}

/// P4b: source.inspect runs (framework detection on real source).
model SourceInspection {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  commitSha     String   @map("commit_sha")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("source_inspections")
}

// ---------------------------------------------------------------------------
// P5 — monitoring, central logs, alerts and incidents
// ---------------------------------------------------------------------------

/// Latest sample per pPanel-managed container from the heartbeat (the set is replaced on every heartbeat).
model ContainerSample {
  serverId      String   @map("server_id") @db.Uuid
  name          String
  /// `ppanel.app` label as reported by the agent
  appName       String   @map("app_name")
  /// resolved by the Center from (server, app name); null = not a managed app of this server
  applicationId String?  @map("application_id") @db.Uuid
  service       String?
  deploymentId  String?  @map("deployment_id") @db.Uuid
  state         String
  health        String?
  restartCount  Int?     @map("restart_count")
  cpuPct        Float?   @map("cpu_pct")
  memBytes      BigInt?  @map("mem_bytes")
  memLimitBytes BigInt?  @map("mem_limit_bytes")
  sampledAt     DateTime @map("sampled_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, name])
  @@index([applicationId])
  @@map("container_samples")
}

/// Per-server telemetry bookkeeping: agent log-shipping state and dropped-entry counters.
model ServerTelemetry {
  serverId             String    @id @map("server_id") @db.Uuid
  logShipping          Json?     @map("log_shipping")
  /// first heartbeat that carried `containers` (app_down only trusts missing containers after this)
  containersReportedAt DateTime? @map("containers_reported_at") @db.Timestamptz(3)
  /// sum of `dropped.entries` reported in log batches (agent buffer overflow)
  agentDroppedTotal    BigInt    @default(0) @map("agent_dropped_total")
  /// entries the Center refused (label spoofing, unknown app, rejected by Loki)
  centerDroppedTotal   BigInt    @default(0) @map("center_dropped_total")
  acceptedTotal        BigInt    @default(0) @map("accepted_total")
  lastDroppedAt        DateTime? @map("last_dropped_at") @db.Timestamptz(3)
  lastBatchAt          DateTime? @map("last_batch_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_telemetry")
}

/// Log batch dedupe (24 h, pruned by the sweeper). status pending while the Loki push is in flight.
model LogBatch {
  serverId   String   @map("server_id") @db.Uuid
  batchId    String   @map("batch_id") @db.Uuid
  status     String   @default("pending")
  accepted   Int      @default(0)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([serverId, batchId])
  @@index([receivedAt])
  @@map("log_batches")
}

/// Single-use, 60 s, user + params bound token for the SSE live tail (EventSource cannot send headers).
model LogTailToken {
  id         String    @id @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  paramsHash String    @map("params_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("log_tail_tokens")
}

model AlertRule {
  id         String   @id @db.Uuid
  name       String
  enabled    Boolean  @default(true)
  scopeType  String   @map("scope_type") // global | environment | server | app
  scopeId    String?  @map("scope_id")
  kind       String
  params     Json     @default("{}")
  severity   String
  forSec     Int      @default(60) @map("for_sec")
  channelIds String[] @default([]) @map("channel_ids")
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  states    AlertState[]
  incidents Incident[]

  @@index([enabled])
  @@map("alert_rules")
}

/// Durable evaluator state per (rule, target). Absent row = condition false (ok).
model AlertState {
  ruleId      String    @map("rule_id") @db.Uuid
  targetType  String    @map("target_type") // server | app
  targetId    String    @map("target_id") @db.Uuid
  status      String // pending | firing
  since       DateTime  @db.Timestamptz(3)
  firedAt     DateTime? @map("fired_at") @db.Timestamptz(3)
  lastValue   Float?    @map("last_value")
  incidentId  String?   @map("incident_id") @db.Uuid
  evaluatedAt DateTime  @map("evaluated_at") @db.Timestamptz(3)

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, targetType, targetId])
  @@map("alert_states")
}

model Incident {
  id               String    @id @db.Uuid
  ruleId           String?   @map("rule_id") @db.Uuid
  ruleName         String    @map("rule_name")
  kind             String
  targetType       String    @map("target_type")
  targetId         String    @map("target_id") @db.Uuid
  targetName       String    @map("target_name")
  serverId         String    @map("server_id") @db.Uuid
  environment      String
  severity         String
  status           String    @default("firing")
  startedAt        DateTime  @map("started_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  lastValue        Float?    @map("last_value")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rule   AlertRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  server Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  events IncidentEvent[]

  @@index([status, startedAt])
  @@index([serverId, startedAt])
  @@index([ruleId, targetType, targetId])
  @@map("incidents")
}

/// Incident timeline (append-only).
model IncidentEvent {
  id         String   @id @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  type       String // fired | notified | notify_failed | acknowledged | resolved | comment
  actorId    String?  @map("actor_id") @db.Uuid
  detail     Json     @default("{}")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
  @@map("incident_events")
}

/// Secret config fields (webhook URL + signing secret, Telegram bot token) are AES-256-GCM encrypted
/// (AAD = "notification_channel:" + id) in config_encrypted; config_public holds display-safe fields.
model NotificationChannel {
  id              String   @id @db.Uuid
  name            String
  type            String // webhook | email | telegram
  enabled         Boolean  @default(true)
  configPublic    Json     @default("{}") @map("config_public")
  configEncrypted String   @map("config_encrypted")
  createdBy       String   @map("created_by") @db.Uuid
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@map("notification_channels")
}

/// Notification outbox (durable, retried by the dispatcher). Never stores message bodies or secrets.
model NotificationDelivery {
  id             String    @id @db.Uuid
  channelId      String    @map("channel_id") @db.Uuid
  incidentId     String?   @map("incident_id") @db.Uuid
  event          String // fired | resolved | test
  status         String    @default("pending") // pending | sending | delivered | failed
  attempts       Int       @default(0)
  error          String?
  responseStatus Int?      @map("response_status")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([channelId, createdAt])
  @@index([incidentId])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------- P6 backups and restores (§10)

/// restic repository behind rest-server (`--private-repos --append-only` for agents, ADR-0009).
model BackupRepository {
  id        String   @id @db.Uuid
  name      String   @unique
  kind      String   @default("rest")
  /// rest-server base URL (no credentials, no per-server path)
  baseUrl   String   @map("base_url")
  /// { kind: "s3", endpoint, bucket } | null — copy is done by the maintenance identity
  offsite   Json?
  createdBy String   @map("created_by") @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  access   BackupRepoAccess[]
  policies BackupPolicy[]
  reports  BackupMaintenanceReport[]

  @@map("backup_repositories")
}

/// Per-server credentials (AES-256-GCM, AAD binds repo+server+purpose). Only the recovery export returns them.
model BackupRepoAccess {
  repositoryId    String    @map("repository_id") @db.Uuid
  serverId        String    @map("server_id") @db.Uuid
  restUser        String    @map("rest_user")
  restPasswordEnc String    @map("rest_password_enc")
  repoPasswordEnc String    @map("repo_password_enc")
  /// set when the operator recorded `maintenance.sh init` (agents are append-only and cannot init)
  initializedAt   DateTime? @map("initialized_at") @db.Timestamptz(3)
  initializedBy   String?   @map("initialized_by") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  repository BackupRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  server     Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([repositoryId, serverId])
  @@unique([repositoryId, restUser])
  @@index([serverId])
  @@map("backup_repo_access")
}

/// Reported by the operator's maintenance script with PPANEL_BACKUP_REPORT_TOKEN (prune/copy/check/unlock).
model BackupMaintenanceReport {
  id           String   @id @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  serverUser   String   @map("server_user")
  kind         String
  ok           Boolean
  finishedAt   DateTime @map("finished_at") @db.Timestamptz(3)
  /// bounded (≤ 8 KiB serialized), redacted
  detail       Json     @default("{}")
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  repository BackupRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, serverUser, kind, finishedAt])
  @@map("backup_maintenance_reports")
}

model BackupPolicy {
  id                String    @id @db.Uuid
  name              String
  serverId          String    @map("server_id") @db.Uuid
  repositoryId      String    @map("repository_id") @db.Uuid
  /// resolved targets (backupTargetSchema + applicationId for app targets)
  targets           Json
  scheduleCron      String    @map("schedule_cron")
  timezone          String
  retention         Json
  verify            Json
  helperImage       String?   @map("helper_image")
  enabled           Boolean   @default(true)
  /// scheduler state (durable across restarts): next slot to run, last slot that produced a run
  nextRunAt         DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastScheduledAt   DateTime? @map("last_scheduled_at") @db.Timestamptz(3)
  lastRestoreTestAt DateTime? @map("last_restore_test_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String    @map("updated_by") @db.Uuid
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server     Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  repository BackupRepository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  runs       BackupRun[]

  @@index([serverId])
  @@index([enabled, nextRunAt])
  @@map("backup_policies")
}

model BackupRun {
  id              String    @id @db.Uuid
  policyId        String    @map("policy_id") @db.Uuid
  serverId        String    @map("server_id") @db.Uuid
  repositoryId    String    @map("repository_id") @db.Uuid
  trigger         String // schedule | manual | safety
  status          String    @default("queued")
  verification    String    @default("none")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  /// targets as dispatched (resolved)
  targets         Json
  snapshots       Json      @default("[]")
  /// { files, bytes, databases, truncated }
  manifestSummary Json      @default("{}") @map("manifest_summary")
  /// bounded: ≤ BACKUP_MANIFEST_MAX_ENTRIES entries (agent truncates beyond)
  manifest        Json      @default("[]")
  resticVersion   String?   @map("restic_version")
  error           Json?
  jobId           String?   @unique @map("job_id") @db.Uuid
  idempotencyKey  String?   @map("idempotency_key")
  scheduledFor    DateTime? @map("scheduled_for") @db.Timestamptz(3)
  /// safety run taken before an in-place restore
  restoreId       String?   @map("restore_id") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy        BackupPolicy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  verifications BackupVerification[]

  @@unique([policyId, idempotencyKey])
  @@index([serverId, createdAt])
  @@index([policyId, createdAt])
  @@index([status, updatedAt])
  @@map("backup_runs")
}

/// One verification attempt of a run: `check` (backup.verify) or `restore_test` (restore.run staging/scratch).
model BackupVerification {
  id         String    @id @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  level      String // check | restore_test
  status     String    @default("running") // running | passed | failed
  jobIds     String[]  @default([]) @map("job_ids") @db.Uuid
  /// per job: { jobId, snapshotId, status, ok, result | error }
  results    Json      @default("[]")
  error      Json?
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  run BackupRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([status])
  @@map("backup_verifications")
}

model Restore {
  id                  String    @id @db.Uuid
  runId               String    @map("run_id") @db.Uuid
  snapshotId          String    @map("snapshot_id")
  serverId            String    @map("server_id") @db.Uuid
  repositoryId        String    @map("repository_id") @db.Uuid
  applicationId       String?   @map("application_id") @db.Uuid
  /// restoreTargetSchema
  target              Json
  /// index of the backup target in the run this snapshot belongs to
  targetIndex         Int       @map("target_index")
  status              String    @default("planned")
  /// RestoreImpactItem[]
  impact              Json
  /// { jobId, ok, listing (bounded), error }
  dryRun              Json?     @map("dry_run")
  planHash            String    @map("plan_hash")
  approvalRequired    Boolean   @map("approval_required")
  approvalReasons     String[]  @default([]) @map("approval_reasons")
  safetySnapshotRunId String?   @map("safety_snapshot_run_id") @db.Uuid
  result              Json?
  error               Json?
  createdBy           String    @map("created_by") @db.Uuid
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(3)

  steps RestoreStepRow[]

  @@index([serverId, createdAt])
  @@index([runId])
  @@index([status, updatedAt])
  @@map("restores")
}

model RestoreStepRow {
  id           String    @id @db.Uuid
  restoreId    String    @map("restore_id") @db.Uuid
  seq          Int
  name         String
  status       String
  jobId        String?   @map("job_id") @db.Uuid
  backupRunId  String?   @map("backup_run_id") @db.Uuid
  deploymentId String?   @map("deployment_id") @db.Uuid
  message      String?
  errorCode    String?   @map("error_code")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)

  restore Restore @relation(fields: [restoreId], references: [id], onDelete: Cascade)

  @@unique([restoreId, seq])
  @@index([jobId])
  @@index([backupRunId])
  @@index([deploymentId])
  @@map("restore_steps")
}

// ---------------------------------------------------------------------------
// P9 — management paths, provider inventory, diagnostics, Gateway routing
// ---------------------------------------------------------------------------

/// Latest management-path probe report of the agent (heartbeat `connection`), 1:1 with servers.
model ServerConnection {
  serverId   String   @id @map("server_id") @db.Uuid
  activePath String?  @map("active_path") // public | private
  /// [{ path, url, ok, latencyMs, checkedAt, error? }]
  endpoints  Json     @default("[]")
  reportedAt DateTime @map("reported_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_connections")
}

/// One row per server per source (agent facts | provider API | user inventory).
model ServerNetworkInventory {
  id            String   @id @db.Uuid
  serverId      String   @map("server_id") @db.Uuid
  source        String // agent | provider | inventory
  region        String?
  vpcUuid       String?  @map("vpc_uuid")
  vpcName       String?  @map("vpc_name")
  dropletId     String?  @map("droplet_id")
  privateIpv4   String?  @map("private_ipv4")
  publicIpv4    String?  @map("public_ipv4")
  /// provider rows: the integration that observed it
  integrationId String?  @map("integration_id") @db.Uuid
  observedAt    DateTime @map("observed_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, source])
  @@index([vpcUuid])
  @@map("server_network_inventory")
}

/// Cloud provider API integration (read-only; GET requests only). Token AES-256-GCM, never returned.
model ProviderIntegration {
  id              String    @id @db.Uuid
  provider        String // digitalocean
  name            String    @unique
  tokenEnc        String    @map("token_enc")
  apiBase         String    @map("api_base")
  status          String    @default("unverified") // ok | error | unverified
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastError       Json?     @map("last_error")
  lastSyncSummary Json?     @map("last_sync_summary")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("provider_integrations")
}

/// network.diagnose runs: single-server diagnostics or a pair (from → to private IPv4) test.
model NetworkConnectivityTest {
  id             String    @id @db.Uuid
  serverId       String    @map("server_id") @db.Uuid
  targetServerId String?   @map("target_server_id") @db.Uuid
  kind           String // diagnose | pair
  params         Json
  result         Json?
  error          Json?
  status         String    @default("queued")
  jobId          String?   @unique @map("job_id") @db.Uuid
  requestedBy    String?   @map("requested_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  server       Server  @relation("connectivityFrom", fields: [serverId], references: [id], onDelete: Cascade)
  targetServer Server? @relation("connectivityTo", fields: [targetServerId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt(sort: Desc)])
  @@map("network_connectivity_tests")
}

/// An enrolled server designated as a Gateway (plain Nginx reverse proxy; config lives on the host).
model Gateway {
  id            String   @id @db.Uuid
  serverId      String   @unique @map("server_id") @db.Uuid
  name          String   @unique
  status        String   @default("active")
  /// the `applications` row (kind = gateway) whose nginx revisions carry the rendered files
  applicationId String   @map("application_id") @db.Uuid
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  routes GatewayRoute[]
  plans  GatewayChangePlan[]

  @@map("gateways")
}

model GatewayRoute {
  id         String   @id @db.Uuid
  gatewayId  String   @map("gateway_id") @db.Uuid
  domain     String   @unique
  mode       String // direct | hybrid | gateway
  /// [{ serverId, address, port }]
  backends   Json
  healthPath String   @default("/") @map("health_path")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@map("gateway_routes")
}

model GatewayChangePlan {
  id               String    @id @db.Uuid
  gatewayId        String    @map("gateway_id") @db.Uuid
  status           String    @default("draft")
  routesSnapshot   Json      @map("routes_snapshot")
  /// [{ path, sha256, content, domain }]
  rendered         Json
  planHash         String    @map("plan_hash")
  nginxRevisionId  String?   @map("nginx_revision_id") @db.Uuid
  shadowResults    Json?     @map("shadow_results")
  /// running shadow test: { phase, probeServerId, jobs: [{ jobId, domain, kind, url }] }
  shadowRun        Json?     @map("shadow_run")
  verification     Json?
  createdBy        String    @map("created_by") @db.Uuid
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  /// the plan_hash the approval was given for (apply refuses when it differs)
  approvedPlanHash String?   @map("approved_plan_hash")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId, createdAt])
  @@index([nginxRevisionId])
  @@map("gateway_change_plans")
}

// ---------------------------------------------------------------------------
// P10 — central SSH gateway (docs/P10_SSH_CONTRACT.md)
// ---------------------------------------------------------------------------

/// Center-held SSH key pair. private_key_enc = AES-256-GCM (PPANEL_MASTER_KEY); never returned/logged.
model SshCredential {
  id                String    @id @db.Uuid
  name              String
  kind              String // generated | imported
  algorithm         String // ssh-ed25519 | rsa-sha2-512 | ecdsa-sha2-nistp256
  publicKey         String    @map("public_key")
  fingerprintSha256 String    @unique @map("fingerprint_sha256")
  privateKeyEnc     String    @map("private_key_enc")
  status            String    @default("active") // active | rotated | revoked
  rotatedFromId     String?   @map("rotated_from_id") @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy         String?   @map("revoked_by") @db.Uuid

  deployments SshKeyDeployment[]

  @@index([status])
  @@map("ssh_credentials")
}

model SshEndpoint {
  id           String   @id @db.Uuid
  serverId     String   @map("server_id") @db.Uuid
  path         String // private | public
  host         String
  port         Int      @default(22)
  allowedUsers String[] @default([]) @map("allowed_users")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server   Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  hostKeys SshHostKey[]

  @@unique([serverId, path])
  @@map("ssh_endpoints")
}

model SshKeyDeployment {
  id           String   @id @db.Uuid
  serverId     String   @map("server_id") @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  sshUser      String   @map("ssh_user")
  status       String   @default("pending") // pending | installed | removing | removed | failed
  jobId        String?  @map("job_id") @db.Uuid
  lastError    String?  @map("last_error")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server     Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  credential SshCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([serverId, credentialId, sshUser])
  @@index([credentialId])
  @@index([jobId])
  @@map("ssh_key_deployments")
}

model SshHostKey {
  id                String    @id @db.Uuid
  serverId          String    @map("server_id") @db.Uuid
  endpointId        String    @map("endpoint_id") @db.Uuid
  algorithm         String
  fingerprintSha256 String    @map("fingerprint_sha256")
  publicKey         String    @map("public_key")
  status            String    @default("pending") // pending | trusted | rejected | superseded
  seenVia           String    @map("seen_via") // scan | connect
  agentMatch        Boolean?  @map("agent_match")
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  trustedBy         String?   @map("trusted_by") @db.Uuid
  trustedAt         DateTime? @map("trusted_at") @db.Timestamptz(3)

  server   Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint SshEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, fingerprintSha256])
  @@index([serverId])
  @@map("ssh_host_keys")
}

model SshAccessGrant {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  serverId     String    @map("server_id") @db.Uuid
  sshUser      String    @map("ssh_user")
  endpointPath String    @map("endpoint_path")
  reason       String
  durationMin  Int       @map("duration_min")
  status       String // awaiting_approval | active | expired | revoked | rejected
  /// sha256(userId|serverId|sshUser|endpointPath|durationMin) — approval compare-and-set
  grantHash    String    @map("grant_hash")
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by") @db.Uuid

  server   Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  sessions SshSession[]

  @@index([userId, status])
  @@index([serverId, status])
  @@index([status, expiresAt])
  @@map("ssh_access_grants")
}

/// One terminal session. Metadata only: never keystrokes or output.
model SshSession {
  id                    String    @id @db.Uuid
  grantId               String    @map("grant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  serverId              String    @map("server_id") @db.Uuid
  sshUser               String    @map("ssh_user")
  endpointPath          String    @map("endpoint_path")
  endpointHost          String    @map("endpoint_host")
  endpointPort          Int       @map("endpoint_port")
  credentialFingerprint String    @map("credential_fingerprint")
  hostKeyFingerprint    String?   @map("host_key_fingerprint")
  status                String    @default("pending") // pending | open | closed | failed
  endReason             String?   @map("end_reason")
  exitCode              Int?      @map("exit_code")
  clientIp              String?   @map("client_ip")
  userAgent             String?   @map("user_agent")
  bytesIn               BigInt    @default(0) @map("bytes_in")
  bytesOut              BigInt    @default(0) @map("bytes_out")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  openedAt              DateTime? @map("opened_at") @db.Timestamptz(3)
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(3)
  /// sha256 hex of the single-use WebSocket ticket (cleared when consumed)
  ticketHash            String?   @unique @map("ticket_hash")
  ticketExpiresAt       DateTime? @map("ticket_expires_at") @db.Timestamptz(3)

  grant  SshAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  server Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([serverId, status])
  @@index([grantId])
  @@index([status])
  @@map("ssh_sessions")
}
