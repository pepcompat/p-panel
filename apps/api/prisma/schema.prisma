// pPanel Center — PostgreSQL schema. snake_case tables/columns (COMPATTANA standard).
// IDs are UUID v7 generated by the application (src/common/ids.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  status       String    @default("active") // active | disabled
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]
  roleBindings  RoleBinding[]

  @@map("users")
}

/// One row per refresh token. Rotation creates a new row in the same family.
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256 hex
  amr              String[]  @default([])
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model MfaFactor {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String    @default("totp")
  secretEnc    String    @map("secret_enc") // AES-256-GCM (PPANEL_MASTER_KEY)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep Int?      @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") // sha256 hex
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model RoleBinding {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleKey     String   @map("role_key")
  scopeType   String   @map("scope_type") // global | environment | project | server
  scopeId     String?  @map("scope_id")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("role_bindings")
}

model ServerGroup {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  environment String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  servers Server[]

  @@map("server_groups")
}

model Server {
  id               String    @id @db.Uuid
  name             String
  hostname         String
  environment      String
  groupId          String?   @map("group_id") @db.Uuid
  tags             String[]  @default([])
  /// Stored lifecycle status. stale/offline are derived on read from last_heartbeat_at.
  status           String    @default("enrolling")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  lastSeq          BigInt?   @map("last_seq")
  agentVersion     String?   @map("agent_version")
  os               Json?
  provider         Json?
  connectionPolicy String    @default("auto") @map("connection_policy")
  metrics          Json?
  metricsSampledAt DateTime? @map("metrics_sampled_at") @db.Timestamptz(3)
  /// systemd units this server's owner allowlisted for typed jobs (service.restart).
  ownedUnits       String[]  @default([]) @map("owned_units")
  /// P4b: Center-side build node designation (agent must also report the `build` capability)
  buildNode        Boolean   @default(false) @map("build_node")
  enrollmentId     String?   @map("enrollment_id") @db.Uuid
  version          Int       @default(1)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group           ServerGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses       ServerAddress[]
  certificates    AgentCertificate[]
  heartbeats      AgentHeartbeat[]
  capabilities    ServerCapability[]
  jobs            Job[]
  scans           DiscoveryScan[]
  applications    Application[]
  managedRouting  ManagedRouting?
  portAllocations HostPortAllocation[]

  @@index([environment])
  @@index([lastHeartbeatAt])
  @@map("servers")
}

model ServerAddress {
  id         String    @id @db.Uuid
  serverId   String    @map("server_id") @db.Uuid
  family     String // ipv4 | ipv6
  scope      String // public | private
  address    String
  interface  String?
  source     String    @default("detected") // detected | override
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, address, source])
  @@map("server_addresses")
}

model AgentEnrollment {
  id          String    @id @db.Uuid
  name        String
  environment String
  tags        String[]  @default([])
  tokenHash   String    @unique @map("token_hash") // sha256 hex, token itself never stored
  ttlMinutes  Int       @map("ttl_minutes")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  serverId    String?   @map("server_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("agent_enrollments")
}

model AgentCertificate {
  id                String    @id @db.Uuid
  serverId          String    @map("server_id") @db.Uuid
  serial            String    @unique // lowercase hex, no leading zeros
  fingerprintSha256 String    @map("fingerprint_sha256")
  certPem           String    @map("cert_pem")
  notBefore         DateTime  @map("not_before") @db.Timestamptz(3)
  notAfter          DateTime  @map("not_after") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("agent_certificates")
}

/// Bounded: retention sweeper keeps the last PPANEL_HEARTBEAT_KEEP rows per server.
model AgentHeartbeat {
  id           BigInt    @id @default(autoincrement())
  serverId     String    @map("server_id") @db.Uuid
  seq          BigInt
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  agentVersion String?   @map("agent_version")
  metrics      Json?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, receivedAt(sort: Desc)])
  @@map("agent_heartbeats")
}

model ServerCapability {
  serverId   String   @map("server_id") @db.Uuid
  name       String
  details    Json?
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, name])
  @@map("server_capabilities")
}

model CaKey {
  id            String   @id @db.Uuid
  purpose       String // agent_ca
  algorithm     String   @default("ECDSA-P256")
  certPem       String   @map("cert_pem")
  privateKeyEnc String   @map("private_key_enc") // AES-256-GCM (PPANEL_MASTER_KEY), PKCS#8
  active        Boolean  @default(true)
  notAfter      DateTime @map("not_after") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, active])
  @@map("ca_keys")
}

model Job {
  id               String    @id @db.Uuid
  serverId         String    @map("server_id") @db.Uuid
  type             String
  params           Json      @default("{}")
  status           String    @default("queued")
  mutating         Boolean
  /// per-server resource lock key for mutating jobs (e.g. "unit:nginx.service")
  resourceKey      String?   @map("resource_key")
  idempotencyKey   String    @map("idempotency_key")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseTokenHash   String?   @map("lease_token_hash")
  leasedAt         DateTime? @map("leased_at") @db.Timestamptz(3)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(3)
  attempt          Int       @default(0)
  desiredVersion   Int?      @map("desired_version")
  actorId          String?   @map("actor_id") @db.Uuid
  correlationId    String    @map("correlation_id")
  result           Json?
  error            Json?
  /// P4: set when the agent fetched this job's secrets (fetch-once, container.run_candidate only)
  secretsFetchedAt DateTime? @map("secrets_fetched_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, idempotencyKey])
  @@index([serverId, status, createdAt])
  @@index([status, leaseUntil])
  @@map("jobs")
}

model AuditEvent {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id")
  actorType  String   @default("user") @map("actor_type") // user | agent | system | anonymous
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  result     String // success | failure | denied
  requestId  String?  @map("request_id")
  diffHash   String?  @map("diff_hash")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// P3 — discovery, applications (ownership tiers), Nginx config revisions
// ---------------------------------------------------------------------------

/// One discovery.scan job → one scan snapshot (ingested idempotently per job_id).
model DiscoveryScan {
  id          String    @id @db.Uuid
  serverId    String    @map("server_id") @db.Uuid
  jobId       String    @unique @map("job_id") @db.Uuid
  status      String    @default("running") // running | completed | failed | expired
  sources     String[]  @default([])
  requestedBy String?   @map("requested_by") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  summary     Json?
  configFiles Json      @default("[]") @map("config_files")
  drift       Json      @default("[]")
  error       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  server   Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  findings DiscoveryFinding[]

  @@index([serverId, completedAt(sort: Desc)])
  @@index([status])
  @@map("discovery_scans")
}

model DiscoveryFinding {
  id                    String   @id @db.Uuid
  scanId                String   @map("scan_id") @db.Uuid
  serverId              String   @map("server_id") @db.Uuid
  kind                  String // nginx_server | php_fpm_pool | listener | container | systemd_unit | upstream
  fingerprint           String
  externalId            String?  @map("external_id")
  title                 String
  domains               String[] @default([])
  listen                String[] @default([])
  provenance            Json?
  confidence            String // high | medium | low
  manualReviewRequired  Boolean  @default(false) @map("manual_review_required")
  reasons               String[] @default([])
  unsupportedDirectives String[] @default([]) @map("unsupported_directives")
  conflicts             Json     @default("[]")
  links                 Json     @default("{}")
  applicationId         String?  @map("application_id") @db.Uuid
  data                  Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scan        DiscoveryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  application Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([scanId, fingerprint])
  @@index([scanId, kind])
  @@index([serverId, fingerprint])
  @@map("discovery_findings")
}

model Application {
  id                       String   @id @db.Uuid
  serverId                 String   @map("server_id") @db.Uuid
  name                     String
  kind                     String // nginx_static | nginx_php | nginx_proxy | unknown | container
  domains                  String[] @default([])
  ownershipMode            String   @default("observed") @map("ownership_mode")
  flagUnsupported          Boolean  @default(false) @map("flag_unsupported")
  flagConflict             Boolean  @default(false) @map("flag_conflict")
  flagManualReview         Boolean  @default(false) @map("flag_manual_review")
  flagDriftDetected        Boolean  @default(false) @map("flag_drift_detected")
  reasons                  String[] @default([])
  unsupportedDirectives    String[] @default([]) @map("unsupported_directives")
  sourceFindingFingerprint String   @map("source_finding_fingerprint")
  /// [{ path, lastKnownSha256 }]
  nginxFiles               Json     @default("[]") @map("nginx_files")
  /// [{ path, lastKnownSha256, currentSha256 }] — non-empty iff flag_drift_detected
  driftFiles               Json     @default("[]") @map("drift_files")
  lastScanId               String?  @map("last_scan_id") @db.Uuid
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server             Server                @relation(fields: [serverId], references: [id], onDelete: Cascade)
  findings           DiscoveryFinding[]
  reviews            AdoptionReview[]
  revisions          NginxConfigRevision[]
  container          ContainerApp?
  secrets            Secret[]
  deployments        Deployment[]
  autoDeployPolicies AutoDeployPolicy[]
  buildConfig        BuildConfig?
  builds             Build[]
  composeVersions    ComposeAppVersion[]
  sourceInspections  SourceInspection[]

  @@unique([serverId, sourceFindingFingerprint])
  @@unique([serverId, name])
  @@index([ownershipMode])
  @@map("applications")
}

/// Ownership tier change history (append-only).
model AdoptionReview {
  id                  String   @id @db.Uuid
  applicationId       String   @map("application_id") @db.Uuid
  fromMode            String   @map("from_mode")
  toMode              String   @map("to_mode")
  actorId             String   @map("actor_id") @db.Uuid
  reason              String
  acknowledgedReasons String[] @default([]) @map("acknowledged_reasons")
  stepUp              Boolean  @default(false) @map("step_up")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("adoption_reviews")
}

model NginxConfigRevision {
  id               String   @id @db.Uuid
  serverId         String   @map("server_id") @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  status           String   @default("draft")
  /// [{ path, beforeSha256, afterSha256, diff, content }]
  files            Json
  planHash         String   @map("plan_hash")
  postchecks       Json     @default("[]")
  approvalRequired Boolean  @map("approval_required")
  validateJobId    String?  @map("validate_job_id") @db.Uuid
  validation       Json?
  applyJobId       String?  @map("apply_job_id") @db.Uuid
  revertJobId      String?  @map("revert_job_id") @db.Uuid
  result           Json?
  createdBy        String   @map("created_by") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvals   NginxRevisionApproval[]

  @@index([applicationId, createdAt])
  @@index([serverId, status])
  @@map("nginx_config_revisions")
}

/// Single-use, planHash-bound approval with expiry.
model NginxRevisionApproval {
  id            String    @id @db.Uuid
  revisionId    String    @map("revision_id") @db.Uuid
  approverId    String    @map("approver_id") @db.Uuid
  planHash      String    @map("plan_hash")
  approvedAt    DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  usedByJobId   String?   @map("used_by_job_id") @db.Uuid
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  revision NginxConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, approvedAt])
  @@map("nginx_revision_approvals")
}

// ---------------------------------------------------------------------------
// P4a — container applications, secrets, deployments, managed routing, webhooks
// ---------------------------------------------------------------------------

/// 1:1 extension of `applications` for kind = container (ownership managed, source of truth = pPanel).
model ContainerApp {
  applicationId        String   @id @map("application_id") @db.Uuid
  containerPort        Int      @map("container_port")
  healthcheck          Json
  resources            Json
  /// plain, non-secret env { KEY: value }
  env                  Json     @default("{}")
  /// declared secret keys (values live in `secrets`)
  secretKeys           String[] @default([]) @map("secret_keys")
  volumes              Json     @default("[]")
  tls                  Json?
  currentDeploymentId  String?  @map("current_deployment_id") @db.Uuid
  previousDeploymentId String?  @map("previous_deployment_id") @db.Uuid
  /// sha256 of the route.conf content pPanel last applied (drift guard for the next switch)
  routeSha256          String?  @map("route_sha256")
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("container_apps")
}

/// AES-256-GCM (PPANEL_MASTER_KEY, AAD = applicationId + ":" + key). Values are never returned.
model Secret {
  id             String   @id @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  key            String
  valueEncrypted String   @map("value_encrypted")
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@map("secrets")
}

model Deployment {
  id                     String    @id @db.Uuid
  applicationId          String    @map("application_id") @db.Uuid
  serverId               String    @map("server_id") @db.Uuid
  number                 Int
  trigger                String // manual | webhook | rollback | redeploy
  image                  String
  sourceRef              Json?     @map("source_ref")
  reason                 String?
  status                 String
  preflight              Json      @default("[]")
  containerName          String?   @map("container_name")
  hostPort               Int?      @map("host_port")
  /// set when the agent confirmed container.remove (or the candidate was removed by the agent)
  containerRemovedAt     DateTime? @map("container_removed_at") @db.Timestamptz(3)
  previousDeploymentId   String?   @map("previous_deployment_id") @db.Uuid
  rollbackOfDeploymentId String?   @map("rollback_of_deployment_id") @db.Uuid
  planHash               String    @map("plan_hash")
  approvalRequired       Boolean   @map("approval_required")
  idempotencyKey         String?   @map("idempotency_key")
  /// commit SHA for webhook dedupe (one deployment per commit per app)
  commitSha              String?   @map("commit_sha")
  webhookDeliveryId      String?   @map("webhook_delivery_id") @db.Uuid
  /// P4b: build that produced the image
  buildId                String?   @map("build_id") @db.Uuid
  /// P4b compose: version deployed + normalised plan with digests/specHashes (no secret values)
  composeVersionId       String?   @map("compose_version_id") @db.Uuid
  plan                   Json?
  /// P4b compose: per-service results reported by compose.apply
  serviceResults         Json?     @map("service_results")
  createdBy              String?   @map("created_by") @db.Uuid
  error                  Json?
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt             DateTime? @map("finished_at") @db.Timestamptz(3)

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  steps       DeploymentStep[]

  @@unique([applicationId, number])
  @@unique([applicationId, idempotencyKey])
  @@index([serverId, status])
  @@index([status, updatedAt])
  @@index([applicationId, commitSha])
  @@map("deployments")
}

model DeploymentStep {
  id           String    @id @db.Uuid
  deploymentId String    @map("deployment_id") @db.Uuid
  seq          Int
  name         String
  status       String    @default("pending")
  jobId        String?   @map("job_id") @db.Uuid
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  message      String?
  errorCode    String?   @map("error_code")
  logTail      String[]  @default([]) @map("log_tail")
  /// step-specific data (e.g. target container for prune/cleanup)
  data         Json      @default("{}")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, seq])
  @@index([jobId])
  @@index([status])
  @@map("deployment_steps")
}

/// Single-use, planHash-bound, expiring approval for deployments and managed-routing bootstrap.
model OperationApproval {
  id            String    @id @db.Uuid
  subjectType   String    @map("subject_type") // deployment | managed_routing
  subjectId     String    @map("subject_id") @db.Uuid
  approverId    String    @map("approver_id") @db.Uuid
  planHash      String    @map("plan_hash")
  approvedAt    DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  usedByJobId   String?   @map("used_by_job_id") @db.Uuid
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, approvedAt])
  @@map("operation_approvals")
}

/// Per-server managed routing bootstrap (/etc/nginx/conf.d/ppanel-managed.conf).
model ManagedRouting {
  serverId         String   @id @map("server_id") @db.Uuid
  status           String // awaiting_approval | applying | enabled | failed | requires_manual_recovery
  /// id used as nginx revisionId (agent backup key)
  revisionId       String   @map("revision_id") @db.Uuid
  planHash         String   @map("plan_hash")
  approvalRequired Boolean  @map("approval_required")
  applyJobId       String?  @map("apply_job_id") @db.Uuid
  error            Json?
  createdBy        String   @map("created_by") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("managed_routing")
}

/// Host ports (127.0.0.1, 20000–29999) reserved for managed containers; row exists while allocated.
model HostPortAllocation {
  serverId      String   @map("server_id") @db.Uuid
  port          Int
  applicationId String?  @map("application_id") @db.Uuid
  deploymentId  String?  @map("deployment_id") @db.Uuid
  containerName String?  @map("container_name")
  /// container | external_in_use (agent reported PORT_IN_USE)
  reason        String   @default("container")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, port])
  @@index([deploymentId])
  @@map("host_port_allocations")
}

model Integration {
  id               String   @id @db.Uuid
  kind             String   @default("github")
  name             String
  /// AES-256-GCM (AAD = "integration:" + id)
  webhookSecretEnc String   @map("webhook_secret_enc")
  enabled          Boolean  @default(true)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]
  policies   AutoDeployPolicy[]

  @@map("integrations")
}

/// Only fields needed for audit/dedupe are stored — never the raw payload.
model WebhookDelivery {
  id            String   @id @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  deliveryId    String   @map("delivery_id")
  event         String
  repo          String?
  ref           String?
  after         String?
  signatureOk   Boolean  @map("signature_ok")
  result        String // deployed | awaiting_approval | ignored | failed
  reasons       String[] @default([])
  deploymentIds String[] @default([]) @map("deployment_ids")
  buildIds      String[] @default([]) @map("build_ids")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryId])
  @@index([integrationId, receivedAt])
  @@map("webhook_deliveries")
}

model AutoDeployPolicy {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  repo          String
  branches      String[]
  /// image | build (P4b)
  mode          String   @default("image")
  /// required in image mode; null in build mode
  imageTemplate String?  @map("image_template")
  enabled       Boolean  @default(true)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, integrationId, repo])
  @@index([integrationId, repo])
  @@map("auto_deploy_policies")
}

/// P4b: per-application build source (container apps).
model BuildConfig {
  applicationId String   @id @map("application_id") @db.Uuid
  repoUrl       String   @map("repo_url")
  subdir        String   @default("")
  dockerfile    String?
  template      String?
  buildArgs     Json     @default("{}") @map("build_args")
  target        String?
  buildServerId String   @map("build_server_id") @db.Uuid
  pushRepo      String   @map("push_repo")
  network       String   @default("default")
  limits        Json     @default("{}")
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String   @map("updated_by") @db.Uuid
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([buildServerId])
  @@map("build_configs")
}

/// P4b: image build from a pinned commit on a build node (image.build job).
model Build {
  id                String    @id @db.Uuid
  applicationId     String    @map("application_id") @db.Uuid
  buildServerId     String    @map("build_server_id") @db.Uuid
  status            String
  commitSha         String    @map("commit_sha")
  branch            String?
  trigger           String
  repo              String?
  dockerfile        String?
  template          String?
  pushRepo          String    @map("push_repo")
  image             String?
  deployAfter       Boolean   @map("deploy_after")
  force             Boolean   @default(false)
  logTail           String[]  @default([]) @map("log_tail")
  /// full bounded log (≤ 2000 lines / 512 KiB), ANSI-free, secret values redacted
  log               String[]  @default([])
  logTruncated      Boolean   @default(false) @map("log_truncated")
  error             Json?
  durationMs        Int?      @map("duration_ms")
  jobId             String?   @map("job_id") @db.Uuid
  deploymentId      String?   @map("deployment_id") @db.Uuid
  deployError       Json?     @map("deploy_error")
  idempotencyKey    String?   @map("idempotency_key")
  webhookDeliveryId String?   @map("webhook_delivery_id") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, commitSha])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("builds")
}

/// P4b: stored compose file versions (validated YAML + normalised plan metadata).
model ComposeAppVersion {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  version       Int
  yaml          String
  yamlSha256    String   @map("yaml_sha256")
  routeService  String   @map("route_service")
  routePort     Int      @map("route_port")
  healthPath    String   @default("/") @map("health_path")
  /// normalised services in dependency order (images as written; no secret values)
  plan          Json
  secretKeys    String[] @default([]) @map("secret_keys")
  warnings      Json     @default("[]")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@map("compose_app_versions")
}

/// P4b: source.inspect runs (framework detection on real source).
model SourceInspection {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  commitSha     String   @map("commit_sha")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("source_inspections")
}
