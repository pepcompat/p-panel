# pPanel Center — /opt/ppanel/.env (mode 0600, root). Written by install.sh from infra/release/env.template.
# install.sh fills every empty secret with `openssl rand` and NEVER overwrites an existing value, so it is
# safe to re-run. Edit non-secret values here, then `docker compose up -d` in /opt/ppanel.
#
# !!! PPANEL_MASTER_KEY encrypts the agent CA key, TOTP secrets, app secrets and backup repo passwords.
# !!! Escrow it OFFLINE, separately from database backups (docs/INSTALL.md §4, RECOVERY_RUNBOOK.md §2).
# !!! Losing it makes every encrypted value in a DB backup unrecoverable.

# ---------------------------------------------------------------- release (pinned; upgrade.sh/rollback.sh edit these)
PPANEL_VERSION=
# registry prefix for released images (local/offline builds: empty → ppanel-api:<v> / ppanel-web:<v>)
PPANEL_IMAGE_PREFIX=ghcr.io/pepcompat/
# full image references, pinned by tag AND digest when pulled from a registry: <prefix>ppanel-api:<v>@sha256:<digest>
PPANEL_API_IMAGE=
PPANEL_WEB_IMAGE=
# local image IDs recorded at install (offline `docker load` images have no registry digest); verified after start
PPANEL_API_IMAGE_ID=
PPANEL_WEB_IMAGE_ID=

# ---------------------------------------------------------------- network
# public DNS name of the Center (web UI + API on 443)
PPANEL_DOMAIN=
# TLS for 443: an e-mail address = Let's Encrypt/ZeroSSL (ACME, needs public DNS + port 80/443 reachable),
# `internal` = Caddy's own CA (lab / private networks; agents then need --ca-file, see docs/INSTALL.md)
PPANEL_TLS=internal
# host name agents use for the mTLS gateway (:4443); defaults to PPANEL_DOMAIN. Prefer a PRIVATE address/name.
PPANEL_GATEWAY_HOST=
# address the gateway port is published on (0.0.0.0 = all; set a private IP to keep it off the internet)
PPANEL_GATEWAY_BIND=0.0.0.0
PPANEL_HTTP_PORT=80
PPANEL_HTTPS_PORT=443
# PostgreSQL is published on loopback ONLY (backup-center.sh / upgrade.sh pg_dump)
PPANEL_DB_LOCAL_PORT=55432

# ---------------------------------------------------------------- secrets (generated by install.sh)
PPANEL_MASTER_KEY=
JWT_ACCESS_SECRET=
POSTGRES_PASSWORD=
# one-time first-boot token for POST /api/v1/setup/bootstrap (ignored once an owner exists)
PPANEL_SETUP_TOKEN=
# bearer for GET /internal/metrics (observability profile only; also written to secrets/scrape-token)
PPANEL_METRICS_SCRAPE_TOKEN=

# ---------------------------------------------------------------- Center behaviour (see .env.example in the repo)
LOG_LEVEL=info
PPANEL_GIT_HOST_ALLOWLIST=github.com
PPANEL_REGISTRY_ALLOWLIST=
# empty = derived N-1 minor of PPANEL_VERSION (RELEASE_CONTRACT §2)
PPANEL_MIN_AGENT_VERSION=
# where enrollment install commands download install-agent.sh (empty = GitHub release of this version)
PPANEL_AGENT_DOWNLOAD_BASE=
PPANEL_SMTP_URL=
PPANEL_SMTP_FROM=pPanel <alerts@localhost>
PPANEL_BACKUP_REPORT_TOKEN=

# ---------------------------------------------------------------- optional profile `observability`
# COMPOSE_PROFILES=observability   (uncomment to run Prometheus + Loki next to the Center)
COMPOSE_PROFILES=
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=2GB
LOKI_RETENTION_PERIOD=168h
LOKI_INGESTION_RATE_MB=8
LOKI_INGESTION_BURST_MB=16

# ---------------------------------------------------------------- Center self-backup (backup-center.sh restic)
# separate restic repo for the Center; its password is escrowed offline, NOT here in production
PPANEL_CENTER_BACKUP_REPO=
PPANEL_CENTER_BACKUP_PASSWORD=
